<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Nested Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- only rewrite when the request is not for a real file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- and not for a real directory -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^.*\.(js|css|map|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|eot)$" negate="true" />
          </conditions>
          <!-- rewrite to the index for the app — use an absolute path to avoid IIS path resolution issues -->
          <!-- <action type="Rewrite" url="/veloTest/index.html" /> -->
          <action type="Rewrite" url="/portal/apps/CommuteApp/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
